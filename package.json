{
  "name": "online-wiki",
  "version": "1.0.0",
  "description": "Lightweight Node.js internal wiki with LDAP/AD and local authentication, file uploads, and TinyMCE editing",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js"
  },
  "dependencies": {
    "connect-flash": "^0.1.1",
    "connect-redis": "^7.1.1",
    "csrf-csrf": "^4.0.3",
    "csrf-sync": "^4.2.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.18.0",
    "fs-extra": "^11.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "ldapauth-fork": "^5.0.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-ldapauth": "^3.0.1",
    "passport-local": "^1.0.0",
    "sanitize-html": "^2.17.7",
    "session-file-store": "^1.5.0",
    "slugify": "^1.6.6",
    "tinymce": "^7.1.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "nodemonConfig": {
    "ignore": [
      "data/*",
      "logs/*",
      "custom-data/*"
    ]
  }
}
