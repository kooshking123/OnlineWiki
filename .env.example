# ── Environment ─────────────────────────────────────────────────────────────────
NODE_ENV=development
# Log level for system logs: error | warn | info | http | debug
# Use 'debug' for maximum verbosity during troubleshooting.
LOG_LEVEL=info

# ── HTTP / HTTPS Server Ports ─────────────────────────────────────────────────
# HTTP is ALWAYS active on PORT (default 3000). HTTPS is OPTIONAL and activates
# ONLY when BOTH SSL_CERT_PATH AND SSL_KEY_PATH are set AND the referenced PEM
# files actually exist on disk at process startup. If either file is missing,
# server.js emits a [tls] warning in system logs and falls back to HTTP-only —
# the process will NOT crash, so partial configs can't take a node down.
#
# Common port picker:
#   • Dev machine (no admin):              PORT=3000   HTTPS_PORT=3443
#   • Direct-access production (root):     PORT=80     HTTPS_PORT=443
#   • Behind nginx / ALB / Cloudflare:     PORT=3000   (leave SSL_* unset)
#
PORT=3000
# HTTPS_PORT=3443

# ── SSL / TLS (optional, for direct HTTPS listener) ─────────────────────────
# Uncomment the two SSL_* lines below to enable a TLS listener on HTTPS_PORT.
# The wiki uses Node's native https.createServer() — no nginx sidecar required
# for direct-access deployments.  Paths are resolved at boot:
#   • absolute paths (/foo, X:\foo, \\filer\foo$) are used verbatim
#   • relative paths (certs/foo.pem, data/dev-tls-*.pem) are resolved via
#     path.resolve(process.cwd(), VALUE).
#
# ── Production (Let's Encrypt certbot):
# SSL_CERT_PATH=/etc/letsencrypt/live/wiki.example.com/fullchain.pem
# SSL_KEY_PATH=/etc/letsencrypt/live/wiki.example.com/privkey.pem
#
# ── Local dev (self-signed SAN cert in DATA_DIR — generated once via README)
#    The file names here match the ones created by the PowerShell / OpenSSL
#    how-to in README → Windows local dev section.
# SSL_CERT_PATH=data/dev-tls-cert.pem
# SSL_KEY_PATH=data/dev-tls-key.pem
#
# Optional CA bundle (private internal CA or extra intermediates not bundled):
# SSL_CA_PATH=/usr/local/share/ca-certificates/corp-intermediate.crt
#
# HTTP → HTTPS upgrade redirect on the plaintext listener.
#   false (DEFAULT)  = dev-friendly dual-stack: both URLs work side-by-side.
#   true             = production strict: GET/HEAD plaintext → 301 to HTTPS
#                      with HSTS set for 1 yr. Bodies (POST/PUT/PATCH)
#                      deliberately not redirected — send those over HTTPS.
# HTTPS_REDIRECT_HTTP=false

# ── Storage: ONE folder for SyncThing / shared storage (DATA_DIR) ───────────
# Every piece of persistent state that must be shared between OnlineWiki instances
# (pages, uploads, avatars, sessions, users.json, settings.json) lives inside
# DATA_DIR. For multi-server deployments, configure SyncThing / DFS / SMB / NFS
# to replicate THIS SINGLE FOLDER across every node — nothing else needs syncing.
#
# ★ DOCKER: Mount DATA_DIR as an EXTERNAL persistent volume. The path below is
# the CONTAINER-side path; map it in docker-compose.yml or `docker run -v` to a
# named volume or a host bind-mount. Use the SAME container-side path on every
# node so SyncThing (which also runs as a container) can replicate the host-side
# volume contents identically across all servers.
#
# Values: relative path (resolved from process.cwd()) OR absolute path.
#
#   Examples (★ = recommended for Docker / production):
#  ★ DATA_DIR=/var/lib/onlinewiki         # Docker: mount to named volume / host path
#     DATA_DIR=/srv/onlinewiki-data       # Linux bare-metal mount (NFS / CephFS)
#     DATA_DIR=X:\OnlineWiki-Data         # Windows mapped drive (DFS-N / SMB share)
#     DATA_DIR=\\filer.corp\wiki$         # Windows UNC (share-account access)
#     DATA_DIR=data                       # legacy, inside repo (non-Docker dev only)
#
DATA_DIR=/var/lib/onlinewiki

# ── Server-local log directory (DO NOT SYNC) ──────────────────────────────────
# Per-instance operational logs + audit trail. Keep this OUTSIDE DATA_DIR so
# SyncThing never even sees it. Relative paths resolve from process.cwd().
#
#   DOCKER: Mount this as a second volume if you want logs to survive container
#   restarts, or leave it inside the container's ephemeral filesystem and rely on
#   `docker logs` / a log-collection sidecar instead.
#
#   Examples:
#  ★ LOG_DIR=/var/log/onlinewiki          # Docker volume or container-internal
#     LOG_DIR=D:\Logs\OnlineWiki          # Windows local disk
#     LOG_DIR=logs                        # legacy, inside repo, next to data/
LOG_DIR=/var/log/onlinewiki

# ── Session ──────────────────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# IMPORTANT (multi-server): Use the IDENTICAL value on EVERY server.
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Session cookie lifetime (absolute server ceiling). In production this should
# be SHORT (e.g. 1h) — we use client-side idle monitoring + warning modal to
# "kick users out after N minutes of idle" regardless. The cookie TTL acts as
# the hard absolute ceiling (e.g. max 12h even if user keeps clicking all day).
SESSION_MAX_AGE_HOURS=8
# Idle-timeout enforcement (client-side activity monitor + warning modal):
#   • SESSION_IDLE_MINUTES: user is considered "idle" this many minutes after
#     their last keypress / mouse move / scroll / touch / click. At this point
#     the browser will perform an INACTIVE auto-logout (POST /logout →
#     redirect to /login?reason=inactive).
#   • SESSION_IDLE_WARN_SECONDS: this many seconds BEFORE the idle threshold
#     is reached, a warning modal appears with a live countdown and two
#     buttons: [Extend session] → GET /api/session/keepalive
#               [Log out now]  → POST /logout
#   Set both to 0 to disable the idle monitor (e.g. on a closed intranet
#   where auto-logout isn't desired).
SESSION_IDLE_MINUTES=15
SESSION_IDLE_WARN_SECONDS=120

# Choose how sessions are stored. Three modes:
#
#   single    SESSION_MODE=single   (DEFAULT if unset)
#              Each server keeps sessions in its own local <DATA_DIR>/sessions/*.json.
#              Built-in reaper cleans up hourly. Users are NOT shared — good for one server
#              or a LB with sticky sessions + a single nominated "login" server.
#
#   syncthing  SESSION_MODE=syncthing
#              Sessions live in <DATA_DIR>/sessions/*.json and are replicated by SyncThing
#              (DATA_DIR itself is the single sync root).
#              BUILT-IN REAPER IS DISABLED — call POST /api/maintenance/expire-sessions
#              ONCE from ONE nominated server (Scheduled Task / cron, hourly).
#              Requirement: enable STICKY SESSIONS on your load balancer (source IP
#              affinity or cookie pinning) to minimise SyncThing-lag race writes.
#              See README → "Multi-Server Deployment with SyncThing" for details.
#
#   redis      SESSION_MODE=redis
#              Sessions in Redis. If REDIS_URL or REDIS_HOST is set, this is auto-selected
#              when SESSION_MODE is not. Use this behind load balancing WITHOUT sticky sessions.
#
# Examples:
# SESSION_MODE=single
# SESSION_MODE=syncthing
# SESSION_MODE=redis

# ── Maintenance token (used with SESSION_MODE=syncthing) ────────────────────
# Shared static bearer token for the ONE nominated reaper server to call
#   POST /api/maintenance/expire-sessions
# without logging in interactively. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be identical on every server (so any server can be the reaper target, but
# you only need to configure ONE server scheduled task pointing to ONE server hostname).
# MAINTENANCE_TOKEN=paste-a-long-random-token

# ── Redis (optional alternative to SyncThing session sharing) ───────────────────────
# If SESSION_MODE=redis, configure these (REDIS_URL or the individual fields below:
#
# Option A — single connection string (takes priority):
#   Format: redis[s]://[[username][:password]@][host][:port][/db-number]
# REDIS_URL=redis://redis-host.internal:6379/0
#
# Option B — individual fields (used when REDIS_URL is not set):
# REDIS_HOST=redis-host.internal
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TLS=false
#
# Optional key prefix to separate apps sharing one Redis instance (default: wiki:sess:)
# REDIS_PREFIX=wiki:sess:

# ── Local admin account (optional fallback) ───────────────────────────────────────
# When set, this account can log in WITHOUT going through LDAP/AD.
# Useful for local development or initial setup before AD is configured.
# IMPORTANT: Remove or leave blank in production to prevent bypassing AD authentication.
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=admin
# Optional: friendly name shown in the UI (defaults to "Local Administrator")
# LOCAL_ADMIN_DISPLAY_NAME=Admin

# ── LDAP / Active Directory ───────────────────────────────────────────────────────
# URL of your domain controller (use ldaps:// for secure LDAP)
LDAP_URL=ldap://your-domain-controller.example.com

# Bind account – a read-only service account used to search the directory
LDAP_BIND_DN=cn=svc-onlinewiki,ou=ServiceAccounts,dc=example,dc=com
LDAP_BIND_PASSWORD=your-service-account-password

# Base DN where user accounts live
LDAP_BASE_DN=dc=example,dc=com

# LDAP filter to locate the authenticating user  ({{username}} is replaced at runtime)
LDAP_SEARCH_FILTER=(sAMAccountName={{username}})

# Set to "false" to disable TLS certificate verification (use only for dev/self-signed certs)
LDAP_TLS_REJECT_UNAUTHORIZED=true
